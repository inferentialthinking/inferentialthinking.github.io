BuaNMcx2Tw"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"In this section, we will give a definition that works consistently for all ranks and all lists.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"Yp16RBr1aT"}],"key":"Q1JKS15hs9"}],"key":"bhu5AHXjAk"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"from datascience import *\n%matplotlib inline\npath_data = '../../../assets/data/'\nimport matplotlib.pyplot as plt\nplt.style.use('fivethirtyeight')\nimport numpy as np","visibility":"remove","key":"i8OqgbuwyP"},{"type":"outputs","id":"dTk2vN8NHpbSeva1q_nHm","children":[],"visibility":"show","key":"vMhzqOULrR"}],"visibility":"show","key":"qq9pae6kzk"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"A Numerical Example","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FAeEgv5Azt"}],"identifier":"a-numerical-example","label":"A Numerical Example","html_id":"a-numerical-example","implicit":true,"key":"TDXffVxStU"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Before giving a general definition of all percentiles, we will define the 80th percentile of a collection of values to be the smallest value in the collection that is at least as large as 80% of all of the values.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"neucjeDGfi"}],"key":"vl6sh2pb8F"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"For example, let’s consider the sizes of the five largest continents – Africa, Antarctica, Asia, North America, and South Ameri