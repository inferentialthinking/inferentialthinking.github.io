aph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"In this section, we will give a definition that works consistently for all ranks and all lists.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"wuh7iOMi4U"}],"key":"jy4uwfUzku"}],"key":"Ooxe8wzoEd"},{"type":"block","kind":"notebook-content","children":[],"key":"MgS8F5PTjv"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"from datascience import *\n%matplotlib inline\npath_data = '../../../assets/data/'\nimport matplotlib.pyplot as plt\nplt.style.use('fivethirtyeight')\nimport numpy as np","visibility":"remove","key":"diID7OEJZ5"},{"type":"outputs","id":"-b85PUY8VJSBLwlHCz9Lv","children":[],"visibility":"show","key":"Ap2zZnwGdy"}],"visibility":"show","key":"tmK3U331io"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"A Numerical Example","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BVYXGwMI5o"}],"identifier":"a-numerical-example","label":"A Numerical Example","html_id":"a-numerical-example","implicit":true,"enumerator":"13.1.1","key":"RDvFQwJ3yv"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Before giving a general definition of all percentiles, we will define the 80th percentile of a collection of values to be the smallest value in the collection that is at least as large as 80% of all of the values.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"OIUvhpR0Sy"}],"key":"YAmnIkzMWz"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"For example, let’s consider the sizes of the five largest