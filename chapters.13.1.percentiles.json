 8th value of the sorted collection, or the 9th, or somewhere in between?","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Vfsrs7ZOHw"}],"key":"ZDOtdIj95b"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"In this section, we will give a definition that works consistently for all ranks and all lists.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"k32zIhwyst"}],"key":"GWKcuVWuMR"}],"key":"tLb8fY6vNY"},{"type":"block","kind":"notebook-content","children":[],"key":"oVj1xFkn0W"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"from datascience import *\n%matplotlib inline\npath_data = '../../../assets/data/'\nimport matplotlib.pyplot as plt\nplt.style.use('fivethirtyeight')\nimport numpy as np","visibility":"remove","key":"XHn4cnkClv"},{"type":"outputs","id":"cBSvu36uwlXDBDdOpmQuG","children":[],"visibility":"show","key":"W34fuzfucT"}],"visibility":"show","key":"ArYAQsdLdy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"A Numerical Example","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xN4sUSneQY"}],"identifier":"a-numerical-example","label":"A Numerical Example","html_id":"a-numerical-example","implicit":true,"enumerator":"13.1.1","key":"KwnFQpNU6y"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Before giving a general definition of all percentiles, we will define the 80th percentile of a collection of values to be the smallest value in the collection that is at least as large as 80% of all of the values.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"N5pX12YemF"}],"k