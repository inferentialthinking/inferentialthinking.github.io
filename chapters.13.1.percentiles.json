 8th value of the sorted collection, or the 9th, or somewhere in between?","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"l5E5IN4cob"}],"key":"lLgrweTruH"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"In this section, we will give a definition that works consistently for all ranks and all lists.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"l08bReKYk5"}],"key":"DR1NB8cqIV"}],"key":"aR3zmDLzfK"},{"type":"block","kind":"notebook-content","children":[],"key":"zu2fQStRcr"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"from datascience import *\n%matplotlib inline\npath_data = '../../../assets/data/'\nimport matplotlib.pyplot as plt\nplt.style.use('fivethirtyeight')\nimport numpy as np","visibility":"remove","key":"lmHoz3ruft"},{"type":"outputs","id":"SOIksGCs2k5p_8JIAeJ4g","children":[],"visibility":"show","key":"jDyOUmHbCn"}],"visibility":"show","key":"LsGwRBntVW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"A Numerical Example","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gJDPSLeFQY"}],"identifier":"a-numerical-example","label":"A Numerical Example","html_id":"a-numerical-example","implicit":true,"enumerator":"13.1.1","key":"sPvG54n33e"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Before giving a general definition of all percentiles, we will define the 80th percentile of a collection of values to be the smallest value in the collection that is at least as large as 80% of all of the values.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"pXz2O2oxug"}],"k