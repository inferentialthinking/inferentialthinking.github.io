line":2,"column":1}},"key":"ZKvxv5v3nA"}],"key":"FeV7arDzaJ"},{"type":"text","value":". A percentile is the value at a particular rank.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"pxzV6103S8"}],"key":"WSPiE692J8"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"For example, if your score on a test is on the 95th percentile, a common interpretation is that only 5% of the scores were higher than yours. The median is the 50th percentile; it is commonly assumed that 50% the values in a data set are above the median.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"XPogyQPL65"}],"key":"ovqaUsdNCE"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"But some care is required in giving percentiles a precise definition that works for all ranks and all lists. To see why, consider an extreme example where all the students in a class score 75 on a test. Then 75 is a natural candidate for the median, but it’s not true that 50% of the scores are above 75. Also, 75 is an equally natural candidate for the 95th percentile or the 25th or any other percentile. Ties – that is, equal data values – have to be taken into account when defining percentiles.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"NVe4V2yYvZ"}],"key":"YXgiLMdNku"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"You also have to be careful about exactly how far up the list to go when the relevant index isn’t clear. For example, what should be the 87th percentile of a collection of 10 values? The 8th value of the sorted collection, or the 9th, or somewhere in between?","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"ciU0S13dhI"}],"key":"vm5ZfWL3AZ"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"In this section, we will give a definition that works consistently for all ranks and all lists.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"DY0NYeJxeb"}],"key":"dWc6S323MQ"}],"key":"uRWnLY4UbA"},{"type":"block","kind":"notebook-content","children":[],"key":"u3dilSAxgo"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"from datascience import *\n%matplotlib inline\npath_data = '../../../assets/data/'\nimport matplotlib.pyplot as plt\nplt.style.use('fivethirtyeight')\nimport numpy as np","visibility":"remove","key":"cu5DxNYkGQ"},{"type":"outputs","id":"leIzwl3UTAABSnmSHtduA","children":[],"visibility":"show","key":"rJYMF0tnlA"}],"visibility":"show","key":"oXd7fULeg7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"A Numerical Example","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gRT1l5sWRg"}],"identifier":"a-numerical-example","label":"A Numerical Example","html_id":"a-numerical-example","implicit":true,"enumerator":"13.1.1","key":"TJ3icJdkj8"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Before giving a general definition of all percentiles, we will define the 80th percentile of a collection of values to be the smallest value in the collection that is at least as large as 80% of all of the values.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ibDXlIaL1o"}],"key":"dxw8dltFez"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"For example, let’s consider the sizes of the five largest