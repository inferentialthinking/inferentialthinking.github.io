xt/plain"}}},"children":[],"key":"YhicPLfcyg"}],"key":"WNwlPKt0jg"}],"key":"CSZyZ1TB4Q"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"delay_bins = np.arange(-20, 201, 10)\nunited.hist('Delay', bins = delay_bins, unit = 'minute')","key":"JkXTgSThmy"},{"type":"outputs","id":"6j7B1Uhc-Cfo7hppsV_zK","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4836b6f4b06d802d1003cb1807e2650c","path":"/build/4836b6f4b06d802d1003cb1807e2650c.png"},"text/plain":{"content":"Histogram with 'Delay (minute) on the x-axis and 'Percent per minute' on the y-axis. The tallest bars are between -10 and 10 and there is a quick drop off in the height of the bars after that. Bars are visible, but very small until about x=140. The graph continues to extend to x=200.","content_type":"text/plain"}}},"children":[],"key":"O2Nhp5ne7E"}],"key":"K1eyLkIzaM"}],"key":"i8DEl9NspC"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The height of the [0, 10) bar is just under 3% per minute, which means that just under 30% of the flights had delays between 0 and 10 minutes. That is confirmed by counting rows:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rxUrbLN6do"}],"key":"CcEgcfO3B0"}],"key":"Wo81TbwqDu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"united.where('Delay', are.between(0, 10)).num_rows/united.num_rows","key":"br8Cadv60A"},{"type":"outputs","id":"2TQprhp85OG63QAktwVuG","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":8,"metadata":{},"data":{"text/plain":{"content":"0.2935985533453888","content_type":"text/plain"}}},"children":[],"key":"YasKmAFwKW"}],"key":"ci5RTtU4lc"}],"key":"W5XNXEfbEW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Empirical Distribution of the Sample","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oWtILvmIA4"}],"identifier":"empirical-distribution-of-the-sample","label":"Empirical Distribution of the Sample","html_id":"empirical-distribution-of-the-sample","implicit":true,"enumerator":"10.2.1","key":"ui7EjYvQ1K"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Let us now think of the 13,825 flights as a population, and draw random samples from it with replacement. It is helpful to package our code into a function. The function ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jRChSzOEzs"},{"type":"inlineCode","value":"empirical_hist_delay","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"y8yV5nzILx"},{"type":"text","value":" takes the sample size as its argument and draws an empiricial histogram of the results.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wgkgR1UQ7i"}],"key":"FqWLoujZUX"}],"key":"kbuJwUTIZy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def empirical_hist_delay(n):\n    united.sample(n).hist('Delay', bins = delay_bins, unit = 'minute')","key":"XBl3QybRCZ"},{"type":"outputs","id":"slbXQASRM_ZcqURGbSbwO","children":[],"key":"hzGCvgTZYx"}],"key":"JLn1WV0qSt"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"As we saw with the dice, as the sample size increases, the empirical histogram of the sample more closely resembles the histogram of the population. Compare these histograms to the population histogram above.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"P7tJSIiVHi"}],"key":"h5tKIhOdjP"}],"key":"Zsnolwm4jM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"empirical_hist_delay(10)","key":"SLHAj7vrKG"},{"type":"outputs","id":"wJl0wTglqUm7_a7x5a66d","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"efa443ac9b2828ef865a612aeb475efb","path":"/build/efa443ac9b2828ef865a612aeb475efb.png"},"text/plain":{"content":"Histogram with 'Delay (minute)' on the x-axis and 'Percent per minute' on the y-axis. The x-axis extends from about -10 to 200. There are three bars with non-zero height, from -10 to 0 with middle height, 0 to 10 with the tallest height, and 10 to 20 with the shortest height.","content_type":"text/plain"}}},"children":[],"key":"kz3iMwc1Og"}],"key":"j8ACbFDviz"}],"key":"kPOEBpE7Zw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"empirical_hist_delay(100)","key":"uNEoKwnpj7"},{"type":"outputs","id":"Fj8QiRFPMD4k5zLL0sNrq","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"7b4b1f536e965c79bf2121043e64c194","path":"/build/7b4b1f536e965c79bf2121043e64c194.png"},"text/plain":{"content":"Histogram with 'Delay (minute)' on the x-axis and 'Percent per minute' on the y-axis. The tallest bars are between -10 and 20. There are a number of short, non-zero height bars between 20 and 110.","content_type":"text/plain"}}},"children":[],"key":"oDUKa3kFkv"}],"key":"laDTuw2M7E"}],"key":"grIEhBgUM8"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The most consistently visible discrepancies are among the values that are rare in the population. In our example, those values are in the the right hand tail of the distribution. But as the sample size increases, even those values begin to appear in the sample in roughly the correct proportions.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EGfdpOvV89"}],"key":"wzv8bHY1xM"}],"key":"uyZsJ2bMvu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"empirical_hist_delay(1000)","key":"Mb9eqsa4i8"},{"type":"outputs","id":"ZBI-n95zhra0K3WH_cLlN","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"99a96375cf9e12196e2e354ff12d3052","path":"/build/99a96375cf9e12196e2e354ff12d3052.png"},"text/plain":{"content":"Histogram with 'Delay (minute)' on the x-axis and 'Percent per minute' on the y-axis. The tallest bars are again between -10 and 20 with short, non-zero height bars extending to about 150.","content_type":"text/plain"}}},"children":[],"key":"kBL7lcZi1X"}],"key":"iYeVmU1aUt"}],"key":"Gj5rtNxzyO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Convergence of the Empirical Histogram of the Sample","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pGVrkuXu4d"}],"identifier":"convergence-of-the-empirical-histogram-of-the-sample","label":"Convergence of the Empirical Histogram of the Sample","html_id":"convergence-of-the-empirical-histogram-of-the-sample","implicit":true,"enumerator":"10.2.2","key":"cFXQBTLbbs"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"What we have observed in this section can be summarized as follows:","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"F5Md3zxy2d"}],"key":"RUcI5W1LB3"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"For a large random sample, the empirical histogram of the sample resembles the histogram of the population, with high probability.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ywwNUEZDN3"}],"key":"Lm3jsP7Nzo"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"This justifies the use of large random samples in statistical inference. The idea is that since a large random sample is likely to resemble the population from which it is drawn, quantities computed from the values in the sample are likely to be close to the corresponding quantities in the population.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"APjWZ9fFZF"}],"key":"tnP8CZrOab"}],"key":"poadhxWlQ4"}],"key":"qsDJ9dGwJb"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Empirical Distributions","url":"/chapters/10/1/empirical-distributions","group":"Computational and Inferential Thinking"},"next":{"title":"Empirical Distribution of a Statistic","url":"/chapters/10/3/empirical-distribution-of-a-statistic","group":"Computational and Inferential Thinking"}}},"domain":"http://localhost:3000"}