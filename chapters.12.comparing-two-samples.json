{"version":3,"kind":"Article","sha256":"e6538263dc5968c7eb3eeaffb5e68a4c5ece803d145e944fe091a16327a2cd8f","slug":"chapters.12.comparing-two-samples","location":"/chapters/12/Comparing_Two_Samples.md","dependencies":[],"frontmatter":{"title":"Comparing Two Samples","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Ani Adhikari","given":"Ani","family":"Adhikari"},"name":"Ani Adhikari","id":"contributors-myst-generated-uid-0"},{"nameParsed":{"literal":"John DeNero","given":"John","family":"DeNero"},"name":"John DeNero","id":"contributors-myst-generated-uid-1"},{"nameParsed":{"literal":"David Wagner","given":"David","family":"Wagner"},"name":"David Wagner","id":"contributors-myst-generated-uid-2"}],"github":"https://github.com/data-8/textbook","numbering":{"title":{"enabled":true},"heading_1":{"enabled":true},"heading_2":{"enabled":true},"heading_3":{"enabled":true},"heading_4":{"enabled":true},"heading_5":{"enabled":true},"heading_6":{"enabled":true}},"source_url":"https://github.com/data-8/textbook/blob/main/chapters/12/Comparing_Two_Samples.md","edit_url":"https://github.com/data-8/textbook/edit/main/chapters/12/Comparing_Two_Samples.md","enumerator":"12","exports":[{"format":"md","filename":"Comparing_Two_Samples.md","url":"/build/Comparing_Two_Sample-11eae4f2e431dbd348692361544a8ca9.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"We have seen several examples of assessing whether a single sample looks like random draws from a specified chance model.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Xq5fpgRknT"}],"key":"TH4cDhZDEx"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Did the Alameda County jury panels look like a random sample from the population of eligible jurors?","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dX2xJQRaNr"}],"key":"xCvPY5Yxnb"}],"key":"nwRuHv0oWK"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Did the pea plants that Mendel grew have colors that were consistent with the chances he specified in his model?","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"UDat8p5w1R"}],"key":"hGYTtIF8dT"}],"key":"q5YVauJd66"}],"key":"oxgRh0olb2"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"In all of these cases there was just one random sample, and we were trying to decide how it had been generated. But often, data scientists have to compare two random samples with each other. For example, they might have to compare the outcomes of patients who have been assigned at random to a treatment group and a control group. Or they might have randomized internet users to receive two different versions of a website, after which they would want to compare the actions of the two random groups.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"cgOO776M3d"}],"key":"TXICft7SuA"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"In this chapter, we develop a way of using Python to compare two random samples and answer questions about the similarities and differences between them. You will see that the methods we develop have diverse applications. Our examples are from medicine and public health as well as football!","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"ZOVpFxUKuv"}],"key":"vJH1djPVA8"}],"key":"drCfnemyvR"}],"key":"hLoIpI1qRG"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Error Probabilities","url":"/chapters/11/4/error-probabilities","group":"Computational and Inferential Thinking"},"next":{"title":"A/B Testing","url":"/chapters/12/1/ab-testing","group":"Computational and Inferential Thinking"}}},"domain":"http://localhost:3000"}